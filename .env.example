# Copie este arquivo para .env e preencha os valores reais.
# Em produção (Railway/Render), configure essas mesmas variáveis no painel do serviço —
# não crie um arquivo .env lá, ele não deve ir para o repositório.

# Connection string do PostgreSQL (Railway/Render), algo como
# "postgresql://usuario:senha@host:5432/nome_do_banco?schema=public"
DATABASE_URL=""

# Segredo usado para assinar os tokens JWT. Gere um valor forte e aleatório em produção,
# por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"

# Porta em que a API escuta. Railway/Render definem isso automaticamente — normalmente
# não é preciso declarar em produção, só localmente se quiser fugir da porta padrão 3001.
PORT=3001

# Lista separada por vírgula das origens (domínios do front-end) autorizadas a chamar a
# API em produção. Sem essa variável, a API libera qualquer origem (adequado só para dev).
# Exemplo: "https://tucumamilgrau.com.br,https://www.tucumamilgrau.com.br"
CORS_ORIGIN=

# --- Usadas só por scripts/ingest-news.ts (ingestor diário de notícias) ---

# URL pública da própria API, usada pelo ingestor pra fazer upload da foto de
# capa (só necessário se o script rodar numa máquina diferente do servidor —
# ex.: Agendador de Tarefas do Windows apontando pra API em produção).
API_URL="https://portal-tucuma-api-production.up.railway.app/api"

# Credenciais de um usuário ADMIN, usadas só pelo ingestor pra logar na API e
# poder enviar a foto de capa das notícias nacionais (Agência Brasil). Sem
# isso, o ingestor continua funcionando normalmente, só sem foto de capa.
INGEST_ADMIN_EMAIL=""
INGEST_ADMIN_PASSWORD=""

# --- E-mail de "esqueci a senha" (via Resend, https://resend.com) ---
# SMTP direto (Gmail) não funciona em hosts como Railway, que bloqueiam saída
# nas portas SMTP. Resend envia por HTTPS, então funciona normalmente.

# API key gerada em resend.com/api-keys.
RESEND_API_KEY=""

# Remetente do e-mail. Sem domínio verificado no Resend, use o padrão de teste
# abaixo. Depois de verificar o domínio (resend.com/domains), troque para algo
# como "Portal Tucumã Milgrau <naoresponda@portaltucumamilgrau.com.br>".
RESEND_FROM_EMAIL="Portal Tucumã Milgrau <onboarding@resend.dev>"

# URL pública do site (front-end), usada para montar o link de redefinição
# de senha enviado por e-mail.
FRONTEND_URL="https://portaltucumamilgrau.com.br"
